# Copy this file to .env.local, then replace the placeholders with real keys.
# .env.local is gitignored and must never be committed.

# Required for the built-in DeepSeek provider used by the local build.
VITE_DENOISE_DEEPSEEK_KEY=sk-your-deepseek-api-key-here

# Optional: Zleap Zev-1 System-1 judge model.
ZLEAP_API_KEY=your_zleap_api_key_here
